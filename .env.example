# DBT Configuration
export DBT_DEFAULT_TARGET=dev

# ============================================
# DEV Environment - Athena Configuration
# ============================================

# AWS Glue Catalog name (usually AwsDataCatalog)
export DEV_CATALOG_NAME=AwsDataCatalog

# Glue database name for DEV environment
# Options: dataplatform-senado-dev-db-raw, dataplatform-senado-dev-db-staging, etc
export DEV_SCHEMA_NAME=dataplatform-senado-dev-db-raw

# S3 path where Athena will store query results
# Format: s3://bucket-name/path/
export DEV_S3_STAGING_DIR=s3://dataplatform-senado-dev-db/athena-results/

# AWS region where Athena is configured
export DEV_REGION=us-east-1

# Athena workgroup name (usually 'primary')
export DEV_WORKGROUP=primary

# ============================================
# PROD Environment - Athena Configuration
# ============================================

export PROD_CATALOG_NAME=AwsDataCatalog
export PROD_SCHEMA_NAME=dataplatform-senado-prod-db-raw
export PROD_S3_STAGING_DIR=s3://dataplatform-senado-prod-db/athena-results/
export PROD_REGION=us-east-1
export PROD_WORKGROUP=primary

# ============================================
# AWS Authentication
# ============================================
# Option 1 (Recommended for local dev): Use AWS CLI credentials
#   - Configure with: aws configure
#   - dbt will automatically use your AWS credentials

# Option 2: Export credentials (if needed)
#   export AWS_ACCESS_KEY_ID=your-access-key
#   export AWS_SECRET_ACCESS_KEY=your-secret-key
#   export AWS_SESSION_TOKEN=your-session-token (if using temporary credentials)

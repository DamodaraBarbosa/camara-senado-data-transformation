# DBT Athena Profile Configuration
#
# HOW TO USE:
# 1. Copy this file to profiles.yml: cp profiles.yml.example profiles.yml
# 2. Load environment variables: source .env
# 3. Run dbt: dbt debug
#
# NOTE: profiles.yml is gitignored - keep your real configuration there only locally
# <BUCKET> segue o padrão dataplatform-camara-<env>-db (ex.: DEV_BUCKET=dataplatform-camara-dev-db)

camara-senado-data-transformation:
  target: "{{ env_var('DBT_DEFAULT_TARGET', 'dev') }}"
  outputs:
    dev:
      type: athena
      region_name: "{{ env_var('DEV_REGION', 'us-east-1') }}"
      database: awsdatacatalog
      schema: "{{ env_var('DEV_BUCKET') }}-staging"
      s3_staging_dir: "s3://{{ env_var('DEV_BUCKET') }}/athena-results/"
      s3_data_dir: "s3://{{ env_var('DEV_BUCKET') }}/dbt/"
      work_group: "{{ env_var('DEV_WORKGROUP', 'primary') }}"
      threads: 4

    prod:
      type: athena
      region_name: "{{ env_var('PROD_REGION', 'us-east-1') }}"
      database: awsdatacatalog
      schema: "{{ env_var('PROD_BUCKET') }}-staging"
      s3_staging_dir: "s3://{{ env_var('PROD_BUCKET') }}/athena-results/"
      s3_data_dir: "s3://{{ env_var('PROD_BUCKET') }}/dbt/"
      work_group: "{{ env_var('PROD_WORKGROUP', 'primary') }}"
      threads: 4
